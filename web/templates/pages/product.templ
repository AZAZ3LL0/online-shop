package pages

import "github.com/qzq-kiim/shop/web/templates/components"

// Product is the single product page. Both covers are loaded eagerly: they are
// the first screen, so tech.md §7.4 keeps them out of lazy loading. The cover
// switch here is a click, not a hover - the visitor already opened the product.
templ Product(view ProductView) {
	<div class="grid gap-10 lg:grid-cols-[3fr_2fr]" x-data="cart">
		<div x-data="{ back: false }">
			<div class="relative aspect-[4/5] overflow-hidden bg-neutral-100">
				<img
					src={ view.Product.ImageFront }
					alt={ view.Product.Title }
					class="absolute inset-0 h-full w-full object-contain transition-opacity duration-300"
					x-bind:class="back ? 'opacity-0' : 'opacity-100'"
				/>
				<img
					src={ view.Product.ImageBack }
					alt={ view.Product.Title + " back" }
					class="absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-300"
					x-bind:class="back ? 'opacity-100' : 'opacity-0'"
				/>
			</div>
			<div class="mt-3 flex gap-2">
				@components.Button(components.ButtonSecondary, "front", templ.Attributes{
					"type":       "button",
					"x-on:click": "back = false",
				})
				@components.Button(components.ButtonSecondary, "back", templ.Attributes{
					"type":       "button",
					"x-on:click": "back = true",
				})
			</div>
		</div>
		<div>
			<h1 class="text-3xl font-semibold tracking-tight">{ view.Product.Title }</h1>
			<p class="mt-2 text-lg">
				@components.Money(view.Product.Price)
			</p>
			<p class="mt-4 text-sm leading-relaxed text-neutral-600">{ view.Product.Description }</p>
			<h2 class="mb-2 mt-8 text-xs font-medium uppercase tracking-wide text-neutral-500">Size run</h2>
			@components.Table([]string{"Size", "Availability"}, sizeRows(view.Product))
			if inStock(view.Product) {
				<form
					method="post"
					action="/cart/items"
					class="mt-6 flex items-end gap-3"
					x-on:submit.prevent="submit($event)"
				>
					<input type="hidden" name="csrf_token" value={ view.CSRFToken }/>
					<input type="hidden" name="qty" value="1"/>
					<div class="flex-1">
						@components.Select("variant_id", "Size", sizeOptions(view.Product), "")
					</div>
					@components.Button(components.ButtonPrimary, "Add to cart", templ.Attributes{"type": "submit"})
				</form>
			} else {
				<div class="mt-6">
					@components.Alert(components.ToneDanger, "This model is sold out.")
				</div>
			}
			<div class="mt-8" id="cart-panel">
				@CartFragment(view.Cart)
			</div>
		</div>
	</div>
}

// sizeRow is one line of the size run table.
templ sizeRow(size string, a availability) {
	<td class="px-3 py-2 font-medium">{ size }</td>
	<td class="px-3 py-2">
		@components.Badge(a.Label, a.Tone)
	</td>
}
