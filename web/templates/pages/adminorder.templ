package pages

import (
	"strconv"

	"github.com/qzq-kiim/shop/internal/domain/order"
	"github.com/qzq-kiim/shop/internal/domain/payment"
	"github.com/qzq-kiim/shop/internal/money"
	"github.com/qzq-kiim/shop/web/templates/components"
)

// AdminOrder is one order card: the lines, the money, the attribution, the
// provider log, the Telegram links and the manual transitions (tech.md §8.4).
templ AdminOrder(view AdminOrderView) {
	<div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
		<div class="flex items-baseline gap-3">
			<h1 class="text-2xl font-semibold tracking-tight">{ view.Detail.Order.Number }</h1>
			@components.StatusPill(view.Detail.Order.Status)
		</div>
		<a href="/admin/orders" class="text-sm text-neutral-500 underline">back to the list</a>
	</div>
	if view.Error != "" {
		<div class="mb-6">
			@components.Alert(components.ToneDanger, view.Error)
		</div>
	}
	<div class="grid gap-6 md:grid-cols-3">
		<section class="border border-neutral-200 bg-white p-4 md:col-span-2">
			<h2 class="mb-3 text-xs uppercase tracking-wide text-neutral-500">Items</h2>
			@components.Table([]string{"Model", "Size", "Unit", "Qty", "Line"}, view.itemRows())
			<dl class="mt-4 grid gap-1 text-sm">
				@adminMoneyLine("Subtotal", view.Detail.Order.Subtotal)
				@adminMoneyLine("Shipping", view.Detail.Order.Shipping)
				@adminMoneyLine("Total", view.Detail.Order.Total)
			</dl>
		</section>
		<section class="border border-neutral-200 bg-white p-4">
			<h2 class="mb-3 text-xs uppercase tracking-wide text-neutral-500">Customer</h2>
			<dl class="grid gap-1 text-sm">
				@adminFactLine(adminFact{Label: "Name", Value: view.Detail.Order.Customer.Name})
				@adminFactLine(adminFact{Label: "Contact", Value: view.Detail.Order.Customer.Contact})
				@adminFactLine(adminFact{Label: "Address", Value: view.Detail.Order.Customer.Address})
				if view.Detail.Order.Customer.Comment != "" {
					@adminFactLine(adminFact{Label: "Comment", Value: view.Detail.Order.Customer.Comment})
				}
			</dl>
			<h2 class="mb-3 mt-6 text-xs uppercase tracking-wide text-neutral-500">Timeline</h2>
			<dl class="grid gap-1 text-sm">
				@adminFactLine(adminFact{Label: "Placed", Value: adminTime(view.Detail.Order.CreatedAt)})
				@adminFactLine(adminFact{Label: "Reserved until", Value: adminTimeOr(view.Detail.Order.ExpiresAt)})
				@adminFactLine(adminFact{Label: "Paid", Value: adminTimeOr(view.Detail.Order.PaidAt)})
				@adminFactLine(adminFact{Label: "Shipped", Value: adminTimeOr(view.Detail.ShippedAt)})
				@adminFactLine(adminFact{Label: "Cancelled", Value: adminTimeOr(view.Detail.CancelledAt)})
			</dl>
		</section>
	</div>
	<div class="mt-6 grid gap-6 md:grid-cols-3">
		<section class="border border-neutral-200 bg-white p-4">
			<h2 class="mb-3 text-xs uppercase tracking-wide text-neutral-500">Move the order</h2>
			if len(view.Detail.ManualTargets()) == 0 {
				<p class="text-sm text-neutral-500">
					Nothing to do by hand from { string(view.Detail.Order.Status) }.
				</p>
			} else {
				<form method="post" action={ templ.SafeURL(view.StatusFormAction()) } class="flex flex-wrap gap-3">
					<input type="hidden" name="csrf_token" value={ view.CSRFToken }/>
					for _, target := range view.Detail.ManualTargets() {
						@components.Button(statusButtonVariant(target), string(target), templ.Attributes{
							"type":  "submit",
							"name":  "status",
							"value": string(target),
						})
					}
				</form>
				<p class="mt-3 text-xs text-neutral-500">
					Every move sends the buyer a message in Telegram.
				</p>
			}
		</section>
		<section class="border border-neutral-200 bg-white p-4">
			<h2 class="mb-3 text-xs uppercase tracking-wide text-neutral-500">Attribution</h2>
			<dl class="grid gap-1 text-sm">
				for _, fact := range touchRows("first", view.Detail.FirstTouch) {
					@adminFactLine(fact)
				}
				for _, fact := range touchRows("last", view.Detail.LastTouch) {
					@adminFactLine(fact)
				}
			</dl>
		</section>
		<section class="border border-neutral-200 bg-white p-4">
			<h2 class="mb-3 text-xs uppercase tracking-wide text-neutral-500">Telegram</h2>
			if len(view.Chats) == 0 {
				<p class="text-sm text-neutral-500">Nobody is following this order yet.</p>
			} else {
				<ul class="grid gap-1 text-sm">
					for _, chat := range view.Chats {
						<li class="flex items-baseline justify-between gap-3">
							<span>
								if chat.Username != "" {
									{ "@" + chat.Username }
								} else {
									{ strconv.FormatInt(chat.ChatID, 10) }
								}
							</span>
							<span class="text-xs text-neutral-500">{ adminTime(chat.LinkedAt) }</span>
						</li>
					}
				</ul>
			}
		</section>
	</div>
	<section class="mt-6 border border-neutral-200 bg-white p-4">
		<h2 class="mb-3 text-xs uppercase tracking-wide text-neutral-500">Provider log</h2>
		if view.PartiallyPaid() {
			@components.Alert(components.ToneWarning, "The provider was short-paid for this order. It stays awaiting payment until the rest arrives, or you settle it by hand.")
		}
		if len(view.Payments) == 0 {
			@components.EmptyState("No provider events", "The order has not reached the payment provider yet.")
		} else {
			@components.Table([]string{"Received", "Provider status", "Signature", "Invoice", "Asked", "Paid"}, view.paymentRows())
		}
	</section>
}

// adminOrderItemRow is one line of the price snapshot taken at checkout.
templ adminOrderItemRow(item order.Item) {
	<td class="px-3 py-2">{ item.ProductTitle }</td>
	<td class="px-3 py-2">{ item.Size }</td>
	<td class="px-3 py-2">
		@components.Money(item.UnitPrice)
	</td>
	<td class="px-3 py-2 tabular-nums">{ strconv.Itoa(item.Qty) }</td>
	<td class="px-3 py-2">
		@components.Money(item.LineTotal())
	</td>
}

// adminPaymentRow is one raw provider event.
templ adminPaymentRow(entry payment.LogEntry) {
	<td class="px-3 py-2 text-neutral-500">{ adminTime(entry.ReceivedAt) }</td>
	<td class="px-3 py-2">{ entry.ProviderStatus }</td>
	<td class="px-3 py-2">
		@components.Badge(signatureLabel(entry.SignatureOK), signatureTone(entry.SignatureOK))
	</td>
	<td class="px-3 py-2 text-xs text-neutral-500">{ entry.ProviderPaymentID }</td>
	<td class="px-3 py-2 tabular-nums">{ amountLabel(entry.PayAmount, entry.PayCurrency) }</td>
	<td class="px-3 py-2 tabular-nums">{ amountLabel(entry.ActuallyPaid, entry.PayCurrency) }</td>
}

// adminFactLine is one label/value pair of a card panel.
templ adminFactLine(fact adminFact) {
	<div class="flex items-baseline justify-between gap-3">
		<dt class="text-neutral-500">{ fact.Label }</dt>
		<dd class="text-right">{ fact.Value }</dd>
	</div>
}

// adminMoneyLine is one money line of the totals block.
templ adminMoneyLine(label string, amount money.Amount) {
	<div class="flex items-baseline justify-between gap-3">
		<dt class="text-neutral-500">{ label }</dt>
		<dd>
			@components.Money(amount)
		</dd>
	</div>
}
