package pages

import (
	"strconv"

	"github.com/qzq-kiim/shop/web/templates/components"
)

// OrderStatus is the public status page. The status itself is rendered by the
// server; the browser only polls it every ten seconds and reloads the page when
// it changes, so there is one renderer of a status in the project (tech.md §7.1).
templ OrderStatus(view OrderView) {
	<script defer src="/static/js/order.js"></script>
	<div class="max-w-2xl" x-data={ orderState(view) }>
		<p class="text-xs uppercase tracking-ornament text-ink-muted">Order</p>
		<h1 class="mb-4 font-display text-4xl tracking-tight">{ view.Order.Number }</h1>
		<div class="mb-6">
			@components.StatusPill(view.Order.Status)
		</div>
		if view.Payable() {
			<div class="mb-6">
				<p class="mb-2 text-sm" x-show="remaining > 0" x-cloak>
					Reservation ends in <span class="tabular-nums" x-text="countdown"></span>.
				</p>
				<a href={ templ.SafeURL(view.Order.InvoiceURL) } class="inline-block bg-accent px-5 py-3 text-sm font-medium uppercase tracking-ornament text-accent-fg transition-opacity duration-200 ease-soft hover:opacity-90">
					Continue to payment
				</a>
			</div>
		}
		if view.Order.Status == "paid" {
			<div class="mb-6">
				@components.Alert(components.ToneSuccess, "Payment received. The order is being prepared.")
			</div>
		}
		if view.Expired() {
			<div class="mb-6">
				@components.Alert(components.ToneWarning, "The reservation has run out. Put the tees back in the cart to order again.")
			</div>
		}
		@TrackInTelegram(view.Track)
		<div class="border border-hair bg-surface p-5">
			<h2 class="mb-4 text-xs font-medium uppercase tracking-ornament text-ink-muted">Items</h2>
			<ul class="divide-y divide-hair/60">
				for _, item := range view.Order.Items {
					<li class="flex items-baseline justify-between gap-3 py-2 text-sm">
						<span>
							{ item.ProductTitle } / { item.Size }
							<span class="text-ink-faint">x { strconv.Itoa(item.Qty) }</span>
						</span>
						@components.Money(item.LineTotal())
					</li>
				}
			</ul>
			@components.Totals(view.Order.Subtotal, view.Order.Shipping, view.Order.Total)
		</div>
		<p class="mt-6 text-xs text-ink-muted">Keep this link: it is the only way back to this page.</p>
	</div>
}
