package pages

import (
	"strconv"

	"github.com/qzq-kiim/shop/web/templates/components"
)

// OrderStatus is the public status page. The status itself is rendered by the
// server; the browser only polls it every ten seconds and reloads the page when
// it changes, so there is one renderer of a status in the project (tech.md §7.1).
templ OrderStatus(view OrderView) {
	<script defer src="/static/js/order.js"></script>
	<div class="max-w-2xl" x-data={ orderState(view) }>
		<p class="text-xs uppercase tracking-wide text-neutral-500">Order</p>
		<h1 class="mb-4 text-3xl font-semibold tracking-tight">{ view.Order.Number }</h1>
		<div class="mb-6">
			@components.StatusPill(view.Order.Status)
		</div>
		if view.Payable() {
			<div class="mb-6">
				<p class="mb-2 text-sm" x-show="remaining > 0" x-cloak>
					Reservation ends in <span class="tabular-nums" x-text="countdown"></span>.
				</p>
				<a href={ templ.SafeURL(view.Order.InvoiceURL) } class="inline-block bg-neutral-900 px-5 py-3 text-sm text-white">
					Continue to payment
				</a>
			</div>
		}
		if view.Order.Status == "paid" {
			<div class="mb-6">
				@components.Alert(components.ToneSuccess, "Payment received. The order is being prepared.")
			</div>
		}
		if view.Expired() {
			<div class="mb-6">
				@components.Alert(components.ToneWarning, "The reservation has run out. Put the tees back in the cart to order again.")
			</div>
		}
		@TrackInTelegram(view.Track)
		<div class="border border-neutral-200 p-4">
			<h2 class="mb-4 text-sm font-medium uppercase tracking-wide">Items</h2>
			<ul class="divide-y divide-neutral-100">
				for _, item := range view.Order.Items {
					<li class="flex items-baseline justify-between gap-3 py-2 text-sm">
						<span>
							{ item.ProductTitle } / { item.Size }
							<span class="text-neutral-500">x { strconv.Itoa(item.Qty) }</span>
						</span>
						@components.Money(item.LineTotal())
					</li>
				}
			</ul>
			<dl class="mt-4 space-y-1 text-sm">
				<div class="flex justify-between">
					<dt class="text-neutral-500">Subtotal</dt>
					<dd>
						@components.Money(view.Order.Subtotal)
					</dd>
				</div>
				<div class="flex justify-between">
					<dt class="text-neutral-500">Shipping</dt>
					<dd>
						@components.Money(view.Order.Shipping)
					</dd>
				</div>
				<div class="flex justify-between border-t border-neutral-200 pt-2 font-medium">
					<dt>Total</dt>
					<dd>
						@components.Money(view.Order.Total)
					</dd>
				</div>
			</dl>
		</div>
		<p class="mt-6 text-xs text-neutral-500">Keep this link: it is the only way back to this page.</p>
	</div>
}
