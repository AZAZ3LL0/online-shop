package templates

import (
	"strconv"

	"github.com/qzq-kiim/shop/web/templates/components"
)

templ head(p Page) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="csrf-token" content={ p.CSRFToken }/>
		<title>{ p.Title }</title>
		<link rel="stylesheet" href="/static/css/app.css"/>
		<script defer src="/static/js/cart.js"></script>
		<script defer src="/static/vendor/alpine.min.js"></script>
	</head>
}

// ribbon is the scrolling slogan under the header, tech.md §19.6. The track
// carries the line four times so two of them always outrun the widest viewport:
// the animation shifts the track by exactly half its width, so the loop has no
// seam. Only the first copy is readable to assistive technology - the rest are
// the same words again and would be read four times over.
templ ribbon() {
	<div class="k-marquee border-y border-hair bg-bg-deep">
		<div class="k-marquee-track animate-marquee py-2">
			<span class="whitespace-nowrap px-6 text-[0.65rem] uppercase tracking-ornament text-gold">{ Slogan }</span>
			for range 3 {
				<span aria-hidden="true" class="whitespace-nowrap px-6 text-[0.65rem] uppercase tracking-ornament text-gold">{ Slogan }</span>
			}
		</div>
	</div>
}

// Shop is the storefront layout: header, cart link, content, footer. It is the
// one place the .shop scope is opened, which is what turns every token of
// tech.md §19.2 from the neutral admin palette into the carpet one.
templ Shop(p Page) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		@head(p)
		<body class="shop flex min-h-full flex-col bg-bg text-ink">
			<div class="h-px w-full bg-gradient-to-r from-transparent via-gold to-transparent"></div>
			<header class="sticky top-0 z-30 border-b border-hair bg-bg-deep/95 backdrop-blur">
				<nav class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4" aria-label="Main">
					<a href="/" class="group flex items-center gap-3">
						<span class="text-gold transition-transform duration-500 ease-soft group-hover:rotate-45">
							@components.Ornament(components.OrnamentRosette)
						</span>
						<span class="font-display text-xl tracking-[0.2em]">QZQ</span>
					</a>
					<div class="flex items-center gap-7 text-xs uppercase tracking-ornament">
						<a href="/" class="transition-colors duration-200 ease-soft hover:text-gold">Shop</a>
						<a href="/cart" class="flex items-center gap-2 transition-colors duration-200 ease-soft hover:text-gold" id="cart-link">
							Cart
							if p.CartCount > 0 {
								<span class="inline-flex min-w-5 justify-center border border-gold px-1 py-0.5 text-[0.6rem] tabular-nums text-gold">
									{ strconv.Itoa(p.CartCount) }
								</span>
							}
						</a>
					</div>
				</nav>
			</header>
			@ribbon()
			<main class="k-field mx-auto w-full max-w-6xl flex-1 px-4 py-12">
				{ children... }
			</main>
			<footer class="border-t border-hair bg-bg-deep">
				@components.Ornament(components.OrnamentBand)
				<div class="mx-auto w-full max-w-6xl px-4 pb-8 pt-6">
					<p class="font-display text-sm tracking-[0.18em] text-gold">{ Slogan }</p>
					<p class="mt-4 text-xs text-ink-muted">
						Order status is available in the Telegram bot.
						if p.IsDev {
							<a href="/dev/kitchen-sink" class="ml-4 underline decoration-gold underline-offset-4">kitchen sink</a>
						}
					</p>
				</div>
			</footer>
		</body>
	</html>
}

// AdminMini is the Telegram Mini App layout: the same pages as AdminWeb, one
// column wide, coloured from themeParams and without a sign-in form - the
// Telegram launch is the only way in (tech.md §5.3, §8).
templ AdminMini(p Page) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<meta name="csrf-token" content={ p.CSRFToken }/>
			<title>{ p.Title }</title>
			<link rel="stylesheet" href="/static/css/app.css"/>
			@p.ThemeStyle()
			<script defer src="/static/js/tgapp.js"></script>
			<script defer src="/static/vendor/alpine.min.js"></script>
		</head>
		<body class="admin-mini flex min-h-full flex-col">
			<header class="admin-mini-bar border-b">
				<nav class="flex items-center justify-between gap-3 px-3 py-2 text-sm" aria-label="Admin">
					<div class="flex items-center gap-3">
						<a href="/tgapp/" class="font-display tracking-[0.18em]">QZQ</a>
						<a href="/tgapp/analytics" class="underline">analytics</a>
					</div>
					if p.AdminUser != "" {
						<span class="admin-mini-hint truncate">{ p.AdminUser }</span>
					}
				</nav>
				// The panel is coloured by Telegram (tech.md §19.1), so the Kazakh
				// layer lends it the hairline only - it reads on any theme.
				@components.Ornament(components.OrnamentRule)
			</header>
			<main class="w-full flex-1 px-3 py-4">
				{ children... }
			</main>
		</body>
	</html>
}

// AdminWeb is the full-width admin layout used in the browser.
templ AdminWeb(p Page) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		@head(p)
		<body class="flex min-h-full flex-col bg-neutral-50">
			<header class="border-b border-neutral-200 bg-white">
				<nav class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-4 py-3 text-sm" aria-label="Admin">
					<div class="flex items-center gap-5">
						<a href="/admin" class="font-semibold">QZQ admin</a>
						if p.AdminUser != "" {
							for _, item := range adminSections {
								<a
									href={ templ.SafeURL(item.Href) }
									class={ adminLinkClasses(p.AdminSection == item.Key) }
								>{ item.Label }</a>
							}
						}
					</div>
					if p.AdminUser != "" {
						<form method="post" action="/admin/logout" class="flex items-center gap-3">
							<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
							<span class="text-neutral-500">{ p.AdminUser }</span>
							<button type="submit" class="underline">log out</button>
						</form>
					}
				</nav>
			</header>
			<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
				{ children... }
			</main>
		</body>
	</html>
}
