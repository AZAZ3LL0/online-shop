package components

import (
	"strconv"

	"github.com/qzq-kiim/shop/internal/domain/order"
	"github.com/qzq-kiim/shop/internal/money"
)

templ Button(variant ButtonVariant, label string, attrs templ.Attributes) {
	<button class={ buttonClasses(variant) } { attrs... }>{ label }</button>
}

templ Badge(text string, tone Tone) {
	<span class={ "inline-flex items-center border px-2 py-0.5 text-xs uppercase tracking-wide", toneClasses(tone) }>
		{ text }
	</span>
}

templ Card(imageFront, imageBack, href, title string, price money.Amount) {
	<article class="group relative" x-data="{ flipped: false }">
		<a href={ templ.SafeURL(href) } class="block">
			<div class="relative aspect-[4/5] overflow-hidden bg-neutral-100">
				<img
					src={ imageFront }
					alt={ title }
					loading="lazy"
					class="absolute inset-0 h-full w-full object-contain transition-opacity duration-300 group-hover:opacity-0"
					x-bind:class="flipped ? 'opacity-0' : 'opacity-100'"
				/>
				<img
					src={ imageBack }
					alt={ title + " back" }
					loading="lazy"
					class="absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-300 group-hover:opacity-100"
					x-bind:class="flipped ? 'opacity-100' : 'opacity-0'"
				/>
			</div>
		</a>
		<button
			type="button"
			x-on:click="flipped = !flipped"
			class="absolute right-2 top-2 border border-neutral-300 bg-white/90 px-2 py-1 text-xs uppercase tracking-wide [@media(hover:hover)]:hidden"
			aria-label="Flip view"
		>flip</button>
		<div class="mt-3 flex items-baseline justify-between gap-3">
			<a href={ templ.SafeURL(href) } class="text-sm font-medium">{ title }</a>
			@Money(price)
		</div>
	</article>
}

templ Input(name, label, value string, kind string, err string) {
	<label class="block">
		<span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">{ label }</span>
		<input
			type={ kind }
			name={ name }
			id={ "field-" + name }
			value={ value }
			class={ inputClasses(err != "") }
		/>
		if err != "" {
			<span class="mt-1 block text-xs text-rose-600">{ err }</span>
		}
	</label>
}

templ Select(name, label string, options []Option, selected string) {
	<label class="block">
		<span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">{ label }</span>
		<select name={ name } id={ "field-" + name } class={ inputClasses(false) }>
			for _, o := range options {
				<option
					value={ o.Value }
					disabled?={ o.Disabled }
					selected?={ o.Value == selected }
				>
					if o.Note != "" {
						{ o.Label + " - " + o.Note }
					} else {
						{ o.Label }
					}
				</option>
			}
		</select>
	</label>
}

templ Textarea(name, label, value string, maxRunes int) {
	<label class="block" x-data={ textareaState(value, maxRunes) }>
		<span class="mb-1 block text-xs uppercase tracking-wide text-neutral-500">{ label }</span>
		<textarea
			name={ name }
			id={ "field-" + name }
			rows="4"
			maxlength={ strconv.Itoa(maxRunes) }
			class={ inputClasses(false) }
			x-model="text"
		>{ value }</textarea>
		<span class="mt-1 block text-right text-xs text-neutral-400" x-text="[...text].length + '/' + max">
			{ counterLabel(len([]rune(value)), maxRunes) }
		</span>
	</label>
}

templ Modal(id, title string, body templ.Component) {
	<div
		id={ id }
		x-data="{ open: false }"
		x-on:open-modal.window="if ($event.detail === $el.id) open = true"
		x-on:keydown.escape.window="open = false"
	>
		<div x-show="open" x-cloak class="fixed inset-0 z-40 bg-black/40" x-on:click="open = false"></div>
		<div
			x-show="open"
			x-cloak
			role="dialog"
			aria-modal="true"
			class="fixed inset-x-4 top-24 z-50 mx-auto max-w-lg border border-neutral-200 bg-white p-6"
		>
			<div class="mb-4 flex items-start justify-between gap-4">
				<h2 class="text-lg font-medium">{ title }</h2>
				<button type="button" class="text-neutral-400 hover:text-neutral-900" x-on:click="open = false" aria-label="Close">x</button>
			</div>
			@body
		</div>
	</div>
}

templ Table(headers []string, rows []templ.Component) {
	<div class="w-full overflow-x-auto">
		<table class="w-full border-collapse text-sm">
			<thead>
				<tr class="border-b border-neutral-200 text-left text-xs uppercase tracking-wide text-neutral-500">
					for _, h := range headers {
						<th scope="col" class="px-3 py-2 font-medium">{ h }</th>
					}
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr class="border-b border-neutral-100">
						@row
					</tr>
				}
			</tbody>
		</table>
	</div>
}

templ Alert(tone Tone, message string) {
	<div role="status" class={ "border px-4 py-3 text-sm", toneClasses(tone) }>{ message }</div>
}

templ Money(amount money.Amount) {
	<span class="tabular-nums">{ amount.String() }</span>
}

templ StatusPill(status order.Status) {
	@Badge(string(status), StatusTone(status))
}

templ EmptyState(title, hint string) {
	<div class="border border-dashed border-neutral-300 px-6 py-12 text-center">
		<p class="text-sm font-medium text-neutral-900">{ title }</p>
		<p class="mt-1 text-sm text-neutral-500">{ hint }</p>
	</div>
}

templ Pagination(page, totalPages int, baseURL string) {
	if totalPages > 1 {
		<nav class="flex items-center gap-1 text-sm" aria-label="Pagination">
			if page > 1 {
				<a href={ templ.SafeURL(pageURL(baseURL, page-1)) } class="border border-neutral-200 px-3 py-1">prev</a>
			}
			for _, p := range pageRange(page, totalPages) {
				if p == page {
					<span aria-current="page" class="border border-neutral-900 bg-neutral-900 px-3 py-1 text-white">{ strconv.Itoa(p) }</span>
				} else {
					<a href={ templ.SafeURL(pageURL(baseURL, p)) } class="border border-neutral-200 px-3 py-1">{ strconv.Itoa(p) }</a>
				}
			}
			if page < totalPages {
				<a href={ templ.SafeURL(pageURL(baseURL, page+1)) } class="border border-neutral-200 px-3 py-1">next</a>
			}
		</nav>
	}
}

templ StatCard(label string, value string, delta string, tone Tone) {
	<div class="border border-neutral-200 p-4">
		<p class="text-xs uppercase tracking-wide text-neutral-500">{ label }</p>
		<p class="mt-2 text-2xl font-medium tabular-nums">{ value }</p>
		if delta != "" {
			<p class="mt-1">
				@Badge(delta, tone)
			</p>
		}
	</div>
}

templ ChartCanvas(id string, kind string) {
	<div class="w-full overflow-x-auto">
		<canvas id={ id } data-chart-kind={ kind } class="w-full" height="240"></canvas>
	</div>
}

templ Toast(id string, tone Tone, message string) {
	<div
		id={ id }
		x-data="{ open: true }"
		x-show="open"
		x-cloak
		x-init="setTimeout(() => open = false, 4000)"
		class={ "fixed bottom-4 right-4 z-50 border px-4 py-3 text-sm shadow-sm", toneClasses(tone) }
		role="status"
	>
		<span>{ message }</span>
		<button type="button" class="ml-3 text-xs uppercase" x-on:click="open = false">close</button>
	</div>
}
