# Copy to .env and fill with real values. NEVER commit .env.
# Always GENERATE FRESH secrets for production — never reuse dev placeholders.

# Server
PORT=8080
ENV=production
BASE_URL=https://qzq.kiim
# Domain used by Nginx (TLS server_name / cert paths).
DOMAIN=qzq.kiim

# Database
# Generate a strong password, e.g.:  openssl rand -base64 24
DB_PASSWORD=your_strong_password
# In Docker Compose the app's DATABASE_URL is derived from DB_PASSWORD and the
# `db` service host automatically — you normally do not need to set it here.
# For local (non-Docker) dev pointing at a local Postgres:
# DATABASE_URL=postgres://qzq_kiim:your_strong_password@localhost:5432/qzq_kiim?sslmode=disable

# Session — REQUIRED in production, min 32 chars. Generate:  openssl rand -hex 32
SESSION_SECRET=your-random-secret-min-32-chars!!

# NowPayments
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
# IPN signing secret — REQUIRED for webhooks; without it payments never confirm.
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
NOWPAYMENTS_SUCCESS_URL=https://qzq.kiim/order/
NOWPAYMENTS_CANCEL_URL=https://qzq.kiim/cart
