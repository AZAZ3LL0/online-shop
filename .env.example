APP_ENV=dev
APP_BASE_URL=http://localhost:8080
APP_SECRET=                      # HMAC for cookies, 32+ bytes
DATABASE_URL=postgres://app:app@postgres:5432/shop?sslmode=disable
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
PAYMENTS_PROVIDER=fake           # fake|nowpayments
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH_SECRET=
TELEGRAM_PROVIDER=fake           # fake|telegram
ADMIN_TELEGRAM_IDS=
ORDER_TTL_MINUTES=30
SHIPPING_CENTS=0

# Deployment only. Read by docker/compose.yml, never by internal/config.
# TODO(contract-gap): tech.md §10.2 does not list these three yet.
SITE_ADDRESS=:80                 # ":80" locally, the bare domain in production
POSTGRES_PASSWORD=app            # generate a random one for production
BACKUP_DIR=/var/backups/qzq-shop # where scripts/backup-db.sh writes dumps
BACKUP_KEEP_DAYS=14
